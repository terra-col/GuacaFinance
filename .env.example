# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# La clave "publishable" (o la "anon" en proyectos antiguos). Nunca la service_role.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Opcional: entrar con el celular (migración 0014). Una llave larga y aleatoria, solo en el servidor;
# en Supabase se guarda su huella (ver el comentario de supabase/migrations/0014_phone_login.sql).
GUACA_LOGIN_KEY=
